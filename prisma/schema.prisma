generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 项目状态
enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum GroupRole {
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  PENDING
}

enum GroupCostMode {
  MEMBER_PAY
  GROUP_POOL
}

// 9步工作流类型
enum WorkflowStepType {
  IDEATION // 创意扩散
  FRAMEWORK // 框架搭建
  STYLE // 风格统一
  CHARACTER // 人物设计
  CONCEPT // 概念图生成
  TRAILER // 30s宣传片
  STORYBOARD // 分镜设计
  KEYFRAMES // 首尾帧
  VIDEO_DIRECT // 直生视频
}

// 步骤执行状态
enum StepStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
}

// 资源类型
enum AssetType {
  IMAGE
  VIDEO
  TEXT
  AUDIO
  REFERENCE
}

enum UserAssetKind {
  CHARACTER
  ENVIRONMENT
  STYLE
  OBJECT
  BRAND
  STORY
  TEXT
  REFERENCE
}

enum UserAssetSource {
  UPLOAD
  GENERATED
  PROJECT
  IMPORT
  MANUAL
}

enum UserAssetContentType {
  IMAGE
  VIDEO
  AUDIO
  TEXT
  CHARACTER_CARD
  ENVIRONMENT_SETTING
  STORY_TEMPLATE
  STYLE_GUIDE
}

// 评测维度
enum EvaluationDimension {
  CONSISTENCY // 时序一致性
  FIDELITY // 语义保真度
  AESTHETICS // 视觉美学
  SPEED // 生成时效
}

// NextAuth.js v5 所需的 Account 模型
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// NextAuth.js v5 所需的 Session 模型
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// NextAuth.js v5 所需的 VerificationToken 模型（Email Magic Link 用）
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                     String                 @id @default(cuid())
  email                  String                 @unique
  name                   String?
  image                  String?
  emailVerified          DateTime?
  points                 Int                    @default(0)
  isAdmin                Boolean                @default(false)
  adminNote              String?
  accounts               Account[]
  sessions               Session[]
  projects               Project[]
  userAssets             UserAsset[]
  userAssetRevisions     UserAssetRevision[]
  auditLogs              AuditLog[]
  operationLogs          OperationLog[]
  rechargeOrders         RechargeOrder[]
  creativeIterations     CreativeIteration[]
  groupMemberships       GroupMembership[]
  createdGroups          Group[]                @relation("CreatedGroups")
  invitedMemberships     GroupMembership[]      @relation("InvitedBy")
  pointTransfersOut      GroupPointTransfer[]   @relation("TransferFromUser")
  scopedChangeProposals  ScopedChangeProposal[]
  storySeries            StorySeries[]          @relation("SeriesOwner")
  seriesBibleRevisions   SeriesBibleRevision[]  @relation("BibleRevisionAuthor")
  createdSeriesAssets    SeriesAsset[]          @relation("SeriesAssetCreator")
  seriesMemberships      SeriesMembership[]
  requestedSeriesBatches SeriesBatchApproval[]  @relation("SeriesBatchRequester")
  reviewedSeriesBatches  SeriesBatchApproval[]  @relation("SeriesBatchReviewer")
  createdAt              DateTime               @default(now())
}

model UserAsset {
  id                String               @id @default(cuid())
  userId            String               @map("user_id")
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind              UserAssetKind
  source            UserAssetSource
  contentType       UserAssetContentType @default(IMAGE) @map("content_type")
  title             String?
  description       String?              @db.Text
  prompt            String?              @db.Text
  templateId        String?              @map("template_id")
  mimeType          String               @map("mime_type")
  storageKey        String               @map("storage_key")
  url               String
  metadata          Json?
  schemaVersion     Int                  @default(1) @map("schema_version")
  structuredPayload Json?                @map("structured_payload")
  currentRevisionId String?              @map("current_revision_id")
  deletedAt         DateTime?            @map("deleted_at")
  purgeAfter        DateTime?            @map("purge_after")
  deletedById       String?              @map("deleted_by_id")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  bindings          AssetBinding[]
  revisions         UserAssetRevision[]
  seriesSnapshots   SeriesAsset[]

  @@index([userId, kind, createdAt])
  @@index([userId, deletedAt, createdAt])
  @@map("user_assets")
}

model UserAssetRevision {
  id                 String                @id @default(cuid())
  userAssetId        String                @map("user_asset_id")
  userAsset          UserAsset             @relation(fields: [userAssetId], references: [id], onDelete: Cascade)
  ownerId            String                @map("owner_id")
  owner              User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  revisionNumber     Int                   @map("revision_number")
  contentType        UserAssetContentType  @default(IMAGE) @map("content_type")
  schemaVersion      Int                   @default(1) @map("schema_version")
  structuredPayload  Json?                 @map("structured_payload")
  mimeType           String?               @map("mime_type")
  storageKey         String?               @map("storage_key")
  contentHash        String?               @map("content_hash")
  promptSnapshot     String?               @map("prompt_snapshot") @db.Text
  generationSnapshot Json?                 @map("generation_snapshot")
  parentRevisionId   String?               @map("parent_revision_id")
  createdAt          DateTime              @default(now()) @map("created_at")
  attachments        UserAssetAttachment[]
  seriesSnapshots    SeriesAsset[]

  @@unique([userAssetId, revisionNumber])
  @@index([ownerId, createdAt])
  @@index([contentHash])
  @@map("user_asset_revisions")
}

model UserAssetAttachment {
  id          String            @id @default(cuid())
  revisionId  String            @map("revision_id")
  revision    UserAssetRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  role        String            @default("PRIMARY")
  position    Int               @default(0)
  mimeType    String            @map("mime_type")
  storageKey  String            @map("storage_key")
  contentHash String?           @map("content_hash")
  metadata    Json?
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([revisionId, position])
  @@index([contentHash])
  @@map("user_asset_attachments")
}

model Project {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String        @default("未命名项目")
  rawIdea           String        @db.Text
  selectedDirection Json? // 选定的创意扩散方向
  framework         Json? // 框架搭建结果（背景/风格/角色/梗概/幕结构）
  selectedStyleId   String? // 关联 Asset.id
  status            ProjectStatus @default(ACTIVE)

  // 框架导入相关字段
  frameworkSource  String? @default("generated") @map("framework_source") // 'generated' | 'imported' | 'mixed'
  importedFileUrl  String? @map("imported_file_url")
  importedFileName String? @map("imported_file_name")
  importedRawText  String? @map("imported_raw_text") @db.Text

  // 小组关联
  groupId String? @map("group_id")
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  // 9步工作流完成状态（条件解锁 DAG 状态机）
  stepIdeaDone                 Boolean @default(false) @map("step_idea_done")
  stepFrameworkDone            Boolean @default(false) @map("step_framework_done")
  stepStyleDone                Boolean @default(false) @map("step_style_done")
  stepCharacterDone            Boolean @default(false) @map("step_character_done")
  stepConceptDone              Boolean @default(false) @map("step_concept_done")
  stepStoryboardDone           Boolean @default(false) @map("step_storyboard_done")
  stepStoryboardFirstframeDone Boolean @default(false) @map("step_storyboard_firstframe_done")
  stepTrailerDone              Boolean @default(false) @map("step_trailer_done")
  stepEndingDone               Boolean @default(false) @map("step_ending_done") // KEYFRAMES
  stepDirectDone               Boolean @default(false) @map("step_direct_done") // VIDEO_DIRECT

  steps                   WorkflowStep[]
  assets                  Asset[]
  comparisons             Comparison[]
  creativeIterations      CreativeIteration[]
  videoSegments           VideoSegment[]
  videoProductionPlans    VideoProductionPlan[]
  generationUnits         GenerationUnit[]
  generatedClips          GeneratedClip[]
  timelineSegments        TimelineSegment[]
  videoQualityAssessments VideoQualityAssessment[]
  videoEvidencePackages   VideoEvidencePackage[]
  productionDeliveryState ProductionDeliveryState?
  productionMilestones    ProductionDeliveryMilestone[]
  voiceoverSegments       VoiceoverSegment[]
  assetBindings           AssetBinding[]
  assetConstraints        ProjectAssetConstraint[]
  scopedChangeProposals   ScopedChangeProposal[]
  storyEpisode            StoryEpisode?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([groupId])
}

// 系列短剧的稳定层级。界面可隐藏只有一季的情况，但数据层始终保留 Season，
// 避免单季作品扩展为多季时重新编号或搬迁项目。
model StorySeries {
  id                       String                          @id @default(cuid())
  userId                   String                          @map("user_id")
  user                     User                            @relation("SeriesOwner", fields: [userId], references: [id], onDelete: Cascade)
  title                    String
  logline                  String?                         @db.Text
  status                   String                          @default("ACTIVE") // ACTIVE | ARCHIVED
  currentBibleVersion      Int                             @default(1) @map("current_bible_version")
  seasons                  StorySeason[]
  episodes                 StoryEpisode[]
  bibleRevisions           SeriesBibleRevision[]
  assets                   SeriesAsset[]
  members                  SeriesMembership[]
  batchApprovals           SeriesBatchApproval[]
  generationAuthorizations SeriesGenerationAuthorization[]
  monthlyPointBudget       Int                             @default(0) @map("monthly_point_budget") // 0 = 不设上限
  batchGenerationLimit     Int                             @default(3) @map("batch_generation_limit")
  requireBatchApproval     Boolean                         @default(true) @map("require_batch_approval")
  createdAt                DateTime                        @default(now()) @map("created_at")
  updatedAt                DateTime                        @updatedAt @map("updated_at")

  @@index([userId, status, updatedAt])
  @@map("story_series")
}

// 系列负责人由 StorySeries.userId 表示；本表只保存协作者及其明确职责。
model SeriesMembership {
  id                 String      @id @default(cuid())
  seriesId           String      @map("series_id")
  series             StorySeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  userId             String      @map("user_id")
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role               String // WRITER | VISUAL | EPISODE_EDITOR | REVIEWER
  assignedEpisodeIds Json        @default("[]") @map("assigned_episode_ids")
  status             String      @default("ACTIVE")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  @@unique([seriesId, userId])
  @@index([userId, status])
  @@map("series_memberships")
}

model SeriesBatchApproval {
  id                       String                          @id @default(cuid())
  seriesId                 String                          @map("series_id")
  series                   StorySeries                     @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  requestedById            String                          @map("requested_by_id")
  requestedBy              User                            @relation("SeriesBatchRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedById             String?                         @map("reviewed_by_id")
  reviewedBy               User?                           @relation("SeriesBatchReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  episodeIds               Json                            @map("episode_ids")
  requestedPoints          Int                             @map("requested_points")
  consumedPoints           Int                             @default(0) @map("consumed_points")
  purpose                  String                          @db.Text
  status                   String                          @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED | CONSUMED
  decisionNote             String?                         @map("decision_note") @db.Text
  expiresAt                DateTime?                       @map("expires_at")
  decidedAt                DateTime?                       @map("decided_at")
  createdAt                DateTime                        @default(now()) @map("created_at")
  updatedAt                DateTime                        @updatedAt @map("updated_at")
  generationAuthorizations SeriesGenerationAuthorization[]

  @@index([seriesId, status, createdAt])
  @@index([requestedById, status])
  @@map("series_batch_approvals")
}

model SeriesGenerationAuthorization {
  id          String               @id @default(cuid())
  seriesId    String               @map("series_id")
  series      StorySeries          @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  approvalId  String?              @map("approval_id")
  approval    SeriesBatchApproval? @relation(fields: [approvalId], references: [id], onDelete: SetNull)
  operationId String               @unique @map("operation_id")
  projectId   String               @map("project_id")
  episodeId   String               @map("episode_id")
  userId      String               @map("user_id")
  points      Int
  status      String               @default("RESERVED") // RESERVED | CONSUMED | RELEASED
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@index([seriesId, status, createdAt])
  @@index([approvalId, status])
  @@index([userId, status])
  @@map("series_generation_authorizations")
}

// 系列公共资产是个人资产某一版本的独立存储快照。个人库切换、软删除或清理
// 不会改变系列和已经建立的单集；新版本必须由用户显式加入系列。
model SeriesAsset {
  id                        String               @id @default(cuid())
  seriesId                  String               @map("series_id")
  series                    StorySeries          @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  sourceUserAssetId         String?              @map("source_user_asset_id")
  sourceUserAsset           UserAsset?           @relation(fields: [sourceUserAssetId], references: [id], onDelete: SetNull)
  sourceUserAssetRevisionId String?              @map("source_user_asset_revision_id")
  sourceUserAssetRevision   UserAssetRevision?   @relation(fields: [sourceUserAssetRevisionId], references: [id], onDelete: SetNull)
  createdById               String               @map("created_by_id")
  createdBy                 User                 @relation("SeriesAssetCreator", fields: [createdById], references: [id], onDelete: Restrict)
  kind                      UserAssetKind
  contentType               UserAssetContentType @map("content_type")
  title                     String
  description               String?              @db.Text
  mimeType                  String               @map("mime_type")
  storageKey                String               @map("storage_key")
  schemaVersion             Int                  @default(1) @map("schema_version")
  structuredPayload         Json?                @map("structured_payload")
  contentHash               String?              @map("content_hash")
  enabled                   Boolean              @default(true)
  createdAt                 DateTime             @default(now()) @map("created_at")
  updatedAt                 DateTime             @updatedAt @map("updated_at")

  @@unique([seriesId, sourceUserAssetRevisionId])
  @@index([seriesId, enabled, createdAt])
  @@index([sourceUserAssetId])
  @@index([sourceUserAssetRevisionId])
  @@map("series_assets")
}

model StorySeason {
  id           String         @id @default(cuid())
  seriesId     String         @map("series_id")
  series       StorySeries    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  seasonNumber Int            @map("season_number")
  title        String?
  synopsis     String?        @db.Text
  episodes     StoryEpisode[]
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@unique([seriesId, seasonNumber])
  @@map("story_seasons")
}

// 系列圣经只追加版本。单集固定指向创建时版本，后续升级必须显式执行。
model SeriesBibleRevision {
  id             String         @id @default(cuid())
  seriesId       String         @map("series_id")
  series         StorySeries    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  revisionNumber Int            @map("revision_number")
  payload        Json
  createdById    String         @map("created_by_id")
  createdBy      User           @relation("BibleRevisionAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  episodes       StoryEpisode[]
  createdAt      DateTime       @default(now()) @map("created_at")

  @@unique([seriesId, revisionNumber])
  @@index([createdById, createdAt])
  @@map("series_bible_revisions")
}

model StoryEpisode {
  id               String              @id @default(cuid())
  seriesId         String              @map("series_id")
  series           StorySeries         @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  seasonId         String              @map("season_id")
  season           StorySeason         @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  projectId        String              @unique @map("project_id")
  project          Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bibleRevisionId  String              @map("bible_revision_id")
  bibleRevision    SeriesBibleRevision @relation(fields: [bibleRevisionId], references: [id], onDelete: Restrict)
  episodeNumber    Int                 @map("episode_number")
  title            String
  synopsis         String?             @db.Text
  status           String              @default("IN_PRODUCTION") // PLANNED | IN_PRODUCTION | COMPLETED
  continuityBefore Json?               @map("continuity_before")
  continuityAfter  Json?               @map("continuity_after")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@unique([seasonId, episodeNumber])
  @@index([seriesId, status, episodeNumber])
  @@index([bibleRevisionId])
  @@map("story_episodes")
}

// 一个步骤的一版生产方案。独立生成、长单元草案与当前激活方案可并存。
model VideoProductionPlan {
  id                    String            @id @default(cuid())
  projectId             String            @map("project_id")
  project               Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stepName              String            @map("step_name")
  strategy              String // INDEPENDENT_SHOTS | MULTI_SHOT_UNITS | MIXED
  status                String            @default("DRAFT") // DRAFT | ACTIVE | ARCHIVED
  modelPolicy           Json?             @map("model_policy")
  qualityPolicy         Json?             @map("quality_policy")
  requestedDurationMs   Int               @default(0) @map("requested_duration_ms")
  billableDurationMs    Int               @default(0) @map("billable_duration_ms")
  estimatedCostUsd      Float?            @map("estimated_cost_usd")
  expectedUsableCostUsd Float?            @map("expected_usable_cost_usd")
  createdById           String?           @map("created_by_id")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  units                 GenerationUnit[]
  timelineSegments      TimelineSegment[]

  @@index([projectId, stepName, status, createdAt])
  // 数据库另有部分唯一索引：每个 projectId + stepName 最多一个 ACTIVE 方案。
  @@map("video_production_plans")
}

// 充值订单
model RechargeOrder {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountYuan    Int      @map("amount_yuan") // 人民币金额（分）
  points        Int // 对应点数
  paymentMethod String   @default("bank_transfer") @map("payment_method") // bank_transfer | alipay | wechat
  proofImageUrl String?  @map("proof_image_url") // 转账凭证图片URL
  status        String   @default("pending") // pending | approved | rejected
  adminNote     String?  @map("admin_note") // 管理员审核备注
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("recharge_orders")
}

model Group {
  id             String               @id @default(cuid())
  name           String
  description    String?              @db.Text
  createdById    String               @map("created_by_id")
  createdBy      User                 @relation("CreatedGroups", fields: [createdById], references: [id], onDelete: Cascade)
  points         Int                  @default(0)
  costMode       GroupCostMode        @default(MEMBER_PAY) @map("cost_mode")
  members        GroupMembership[]
  projects       Project[]
  pointTransfers GroupPointTransfer[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([createdById])
}

model GroupMembership {
  id          String           @id @default(cuid())
  groupId     String           @map("group_id")
  group       Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId      String           @map("user_id")
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        GroupRole        @default(MEMBER)
  status      MembershipStatus @default(ACTIVE)
  invitedById String?          @map("invited_by_id")
  invitedBy   User?            @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  joinedAt    DateTime         @default(now()) @map("joined_at")
  createdAt   DateTime         @default(now())

  @@unique([groupId, userId])
  @@index([userId, status])
  @@map("group_memberships")
}

model GroupPointTransfer {
  id         String   @id @default(cuid())
  groupId    String   @map("group_id")
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation("TransferFromUser", fields: [userId], references: [id], onDelete: Cascade)
  amount     Int
  userAfter  Int      @map("user_after")
  groupAfter Int      @map("group_after")
  createdAt  DateTime @default(now())

  @@index([groupId])
  @@index([userId])
  @@map("group_point_transfers")
}

model WorkflowStep {
  id                    String                 @id @default(cuid())
  projectId             String
  project               Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stepType              WorkflowStepType
  status                StepStatus             @default(PENDING)
  inputData             Json? // 该步输入参数
  outputData            Json? // 该步输出结果
  errorMessage          String?                @db.Text
  order                 Int // 步骤顺序（0-8）
  retryCount            Int                    @default(0)
  startedAt             DateTime?
  completedAt           DateTime?
  resultAssets          Asset[] // 关联生成的资源
  scopedChangeProposals ScopedChangeProposal[]
  // 乐观锁 CAS 字段：并发局部更新 outputData 时用于检测期间是否有别的写入
  // 见 lib/workflow-executor.mergeStepOutputData
  updatedAt             DateTime               @updatedAt @map("updated_at")
  createdAt             DateTime               @default(now())

  @@unique([projectId, stepType]) // 一个项目同一步骤只能有一条记录
  @@index([projectId, order])
}

// 用户框定范围后生成的可审查修改草案。应用前必须校验 baseHash，防止覆盖并发编辑。
model ScopedChangeProposal {
  id             String           @id @default(cuid())
  projectId      String           @map("project_id")
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflowStepId String           @map("workflow_step_id")
  workflowStep   WorkflowStep     @relation(fields: [workflowStepId], references: [id], onDelete: Cascade)
  createdById    String           @map("created_by_id")
  createdBy      User             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  stepType       WorkflowStepType @map("step_type")
  scopeType      String           @map("scope_type")
  scopeKey       String           @map("scope_key")
  instruction    String           @db.Text
  baseHash       String           @map("base_hash")
  beforeSnapshot Json             @map("before_snapshot")
  operations     Json
  summary        String?          @db.Text
  status         String           @default("DRAFT") // DRAFT | APPLIED | REJECTED | STALE
  appliedAt      DateTime?        @map("applied_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@index([projectId, status, createdAt])
  @@index([workflowStepId, scopeType, scopeKey, createdAt])
  @@index([createdById, createdAt])
  @@map("scoped_change_proposals")
}

model Asset {
  id                        String                   @id @default(cuid())
  projectId                 String
  project                   Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stepId                    String?
  step                      WorkflowStep?            @relation(fields: [stepId], references: [id], onDelete: SetNull)
  type                      AssetType
  contentType               UserAssetContentType     @default(IMAGE) @map("content_type")
  mimeType                  String
  storageKey                String // R2 上的唯一 key
  url                       String // 预签名 URL（短期）
  metadata                  Json? // { seed, modelUsed, prompt, duration, size, styleRef, characterRef }
  schemaVersion             Int                      @default(1) @map("schema_version")
  structuredPayload         Json?                    @map("structured_payload")
  sourceUserAssetId         String?                  @map("source_user_asset_id")
  sourceUserAssetRevisionId String?                  @map("source_user_asset_revision_id")
  contentHash               String?                  @map("content_hash")
  deletedAt                 DateTime?                @map("deleted_at")
  purgeAfter                DateTime?                @map("purge_after")
  deletedById               String?                  @map("deleted_by_id")
  purgeCompletedAt          DateTime?                @map("purge_completed_at")
  createdById               String?
  origin                    String                   @default("GENERATED")
  createdAt                 DateTime                 @default(now())
  bindings                  AssetBinding[]
  constraints               ProjectAssetConstraint[]

  @@unique([projectId, sourceUserAssetRevisionId])
  @@index([projectId, type])
  @@index([stepId])
  @@index([createdById, createdAt])
  @@index([projectId, deletedAt, createdAt])
  @@index([sourceUserAssetRevisionId])
}

model AssetBinding {
  id            String     @id @default(cuid())
  projectId     String     @map("project_id")
  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userAssetId   String?    @map("user_asset_id")
  userAsset     UserAsset? @relation(fields: [userAssetId], references: [id], onDelete: Cascade)
  assetId       String?    @map("asset_id")
  asset         Asset?     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  targetType    String     @map("target_type")
  targetKey     String     @map("target_key")
  referenceRole String     @default("GENERAL") @map("reference_role")
  priority      Int        @default(0)
  enabled       Boolean    @default(true)
  createdById   String?    @map("created_by_id")
  metadata      Json?
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@index([projectId, targetType, targetKey, enabled])
  @@index([userAssetId])
  @@index([assetId])
  @@map("asset_bindings")
}

model ProjectAssetConstraint {
  id              String           @id @default(cuid())
  projectId       String           @map("project_id")
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assetId         String           @map("asset_id")
  asset           Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  targetStep      WorkflowStepType @map("target_step")
  targetKey       String           @default("") @map("target_key")
  interpretation  String           @default("CONSTRAINTS")
  strength        String           @default("SOFT")
  scope           String           @default("STEP")
  mergeStrategy   String           @default("ADD") @map("merge_strategy")
  selectedFields  Json?            @map("selected_fields")
  payloadSnapshot Json             @map("payload_snapshot")
  enabled         Boolean          @default(true)
  createdById     String?          @map("created_by_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@unique([projectId, assetId, targetStep, targetKey])
  @@index([projectId, targetStep, enabled])
  @@index([assetId])
  @@map("project_asset_constraints")
}

model Evaluation {
  id           String              @id @default(cuid())
  assetId      String
  comparisonId String?
  dimension    EvaluationDimension
  aiScore      Float? // 自动评测 1-10
  humanScore   Float? // 人工评分 1-10
  details      Json? // 帧级标记、差异说明等
  createdAt    DateTime            @default(now())

  @@index([assetId, dimension])
}

model Comparison {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scriptSnapshot Json // 评测时的分镜脚本快照
  modelResults   Json // { modelName: { taskId, assetId, status, url, cost } }
  overallScores  Json? // 各模型总分
  status         String   @default("PENDING") // PENDING, PROCESSING, COMPLETED
  createdAt      DateTime @default(now())

  @@index([projectId, status])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // GENERATE_IMAGE, GENERATE_VIDEO, LOGIN, EXPORT 等
  inputHash String? // 输入提示词的 SHA256
  outputUrl String?
  modelUsed String?
  ipAddress String?
  userAgent String?
  errorCode String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model OperationLog {
  id               String                @id @default(uuid())
  userId           String
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             String // legacy: generate, regenerate, error
  actionKey        String                @default("generation.unknown")
  category         String                @default("OTHER")
  status           String                @default("SUBMITTED")
  projectId        String?
  workflowStepId   String?
  stepName         String?
  scopeType        String?
  scopeKey         String?
  assetId          String? // legacy polymorphic result id
  pointsCost       Int                   @default(0)
  pointsRefunded   Int                   @default(0)
  success          Boolean               @default(true)
  errorCode        String?
  errorMessage     String?
  billingSource    String                @default("USER")
  billingGroupId   String?
  balanceAfter     Int?
  providerCost     Decimal?              @db.Decimal(18, 8)
  currency         String?
  costSource       String                @default("UNKNOWN")
  idempotencyKey   String?               @unique
  inputSummary     Json?
  metadata         Json?
  startedAt        DateTime              @default(now())
  completedAt      DateTime?
  durationMs       Int?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  providerAttempts ProviderCallAttempt[]
  results          OperationResult[]

  @@index([userId, createdAt])
  @@index([billingGroupId, createdAt])
  @@index([type, createdAt])
  @@index([status, createdAt])
  @@index([projectId, createdAt])
  @@index([projectId, scopeType, scopeKey])
  @@index([category, createdAt])
}

model ProviderCallAttempt {
  id             String       @id @default(uuid())
  operationId    String
  operation      OperationLog @relation(fields: [operationId], references: [id], onDelete: Cascade)
  provider       String
  model          String?
  endpoint       String
  method         String       @default("POST")
  attemptNo      Int          @default(1)
  status         String       @default("RUNNING")
  externalTaskId String?
  requestId      String?
  httpStatus     Int?
  pollCount      Int          @default(0)
  providerCost   Decimal?     @db.Decimal(18, 8)
  currency       String?
  costSource     String       @default("UNKNOWN")
  inputTokens    Int?
  outputTokens   Int?
  totalTokens    Int?
  reconciledAt   DateTime?
  errorCode      String?
  errorMessage   String?
  metadata       Json?
  startedAt      DateTime     @default(now())
  completedAt    DateTime?
  durationMs     Int?

  @@index([operationId, startedAt])
  @@index([provider, model, startedAt])
  @@index([externalTaskId])
  @@index([requestId])
}

model OperationResult {
  id                 String       @id @default(uuid())
  operationId        String
  operation          OperationLog @relation(fields: [operationId], references: [id], onDelete: Cascade)
  kind               String
  title              String?
  assetId            String?
  userAssetId        String?
  videoSegmentId     String?
  voiceoverSegmentId String?
  storageKey         String?
  mimeType           String?
  externalUrl        String?
  isMock             Boolean      @default(false)
  targetType         String?
  targetKey          String?
  targetLabel        String?
  shotId             String?
  actNumber          Int?
  adoptionStatus     String       @default("GENERATED")
  adoptedAt          DateTime?
  adoptedById        String?
  metadata           Json?
  createdAt          DateTime     @default(now())

  @@unique([operationId, assetId])
  @@unique([operationId, userAssetId])
  @@unique([operationId, videoSegmentId])
  @@unique([operationId, voiceoverSegmentId])
  @@index([operationId, createdAt])
  @@index([targetType, targetKey])
  @@index([adoptionStatus, createdAt])
}

// 创意扩散深化迭代历史版本
model VideoSegment {
  id                  String               @id @default(cuid())
  projectId           String               @map("project_id")
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shotId              String               @map("shot_id") // 对应分镜 shot_001 / 概念图 asset id
  actNumber           Int?                 @map("act_number") // VIDEO_DIRECT 中区分不同幕的同名 shotId
  stepName            String               @map("step_name") // 'TRAILER' | 'VIDEO_DIRECT' | 'VIDEO_RENDER'
  prompt              String // 英文视频生成提示词
  caption             String?              @map("caption") // 中文画面描述（前端展示用）
  videoUrl            String?              @map("video_url") // 生成后的视频 URL（R2 签名 URL）
  storageKey          String?              @map("storage_key") // R2 存储 key
  status              String               @default("pending") @map("status") // pending | generating | completed | failed
  sequence            Int                  @map("sequence") // 片段顺序（用于 ffmpeg concat）
  duration            Int?                 @map("duration") // 片段时长（秒）
  isMock              Boolean              @default(false) @map("is_mock") // 是否 Ken Burns 兜底
  errorMessage        String?              @map("error_message") // 失败原因
  createdById         String?              @map("created_by_id")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  generationUnitItems GenerationUnitItem[]

  @@index([projectId, status])
  @@index([projectId, stepName])
  @@index([projectId, sequence])
  @@index([projectId, stepName, actNumber, shotId])
  @@index([createdById, createdAt])
  @@map("VideoSegment")
}

// 一次供应商生成请求。它可以承载一个镜头，也可以承载内部包含多个切镜的长生成单元。
model GenerationUnit {
  id                  String               @id @default(cuid())
  projectId           String               @map("project_id")
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  planId              String?              @map("plan_id")
  plan                VideoProductionPlan? @relation(fields: [planId], references: [id], onDelete: Cascade)
  stepName            String               @map("step_name")
  strategy            String               @default("SINGLE_SHOT") // SINGLE_SHOT | MULTI_SHOT
  status              String               @default("planned") // planned | queued | generating | completed | failed | cancelled
  tier                String? // hero | standard | budget
  modelId             String?              @map("model_id")
  prompt              String               @db.Text
  requestedDurationMs Int                  @map("requested_duration_ms")
  billableDurationMs  Int?                 @map("billable_duration_ms")
  referenceAssets     Json?                @map("reference_assets")
  estimatedCostUsd    Float?               @map("estimated_cost_usd")
  actualCostUsd       Float?               @map("actual_cost_usd")
  providerTaskId      String?              @map("provider_task_id")
  errorMessage        String?              @map("error_message")
  createdById         String?              @map("created_by_id")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  items               GenerationUnitItem[]
  clips               GeneratedClip[]
  timelineSegments    TimelineSegment[]

  @@index([projectId, stepName, status])
  @@index([planId, status])
  @@index([projectId, createdAt])
  @@index([providerTaskId])
  @@map("generation_units")
}

// 生成单元中的创作镜头计划。一个 MULTI_SHOT 单元会有多个 item。
model GenerationUnitItem {
  id                String         @id @default(cuid())
  generationUnitId  String         @map("generation_unit_id")
  generationUnit    GenerationUnit @relation(fields: [generationUnitId], references: [id], onDelete: Cascade)
  legacySegmentId   String?        @map("legacy_segment_id")
  legacySegment     VideoSegment?  @relation(fields: [legacySegmentId], references: [id], onDelete: SetNull)
  shotId            String         @map("shot_id")
  actNumber         Int?           @map("act_number")
  sequence          Int
  plannedDurationMs Int            @map("planned_duration_ms")
  prompt            String?        @db.Text
  metadata          Json?
  createdAt         DateTime       @default(now()) @map("created_at")

  @@unique([generationUnitId, sequence])
  @@index([legacySegmentId])
  @@index([shotId, actNumber])
  @@map("generation_unit_items")
}

// 供应商返回并保存到对象存储的原始素材。一个生成单元可以产生多个候选素材。
model GeneratedClip {
  id                 String                   @id @default(cuid())
  projectId          String                   @map("project_id")
  project            Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generationUnitId   String                   @map("generation_unit_id")
  generationUnit     GenerationUnit           @relation(fields: [generationUnitId], references: [id], onDelete: Cascade)
  modelId            String?                  @map("model_id")
  providerTaskId     String?                  @map("provider_task_id")
  videoUrl           String?                  @map("video_url")
  storageKey         String?                  @map("storage_key")
  durationMs         Int                      @map("duration_ms")
  isMock             Boolean                  @default(false) @map("is_mock")
  metadata           Json?
  createdAt          DateTime                 @default(now()) @map("created_at")
  timelineSegments   TimelineSegment[]
  qualityAssessments VideoQualityAssessment[]
  evidencePackage    VideoEvidencePackage?

  @@index([projectId, createdAt])
  @@index([generationUnitId, createdAt])
  @@index([providerTaskId])
  @@map("generated_clips")
}

// 原始视频素材的审片证据包。技术证据与人工处置分开保存，避免评分冒充验收。
model VideoEvidencePackage {
  id                         String        @id @default(cuid())
  projectId                  String        @map("project_id")
  project                    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generatedClipId            String        @unique @map("generated_clip_id")
  generatedClip              GeneratedClip @relation(fields: [generatedClipId], references: [id], onDelete: Cascade)
  contactSheetStorageKey     String?       @map("contact_sheet_storage_key")
  contactSheetFrameTimesMs   Json          @default("[]") @map("contact_sheet_frame_times_ms")
  contactSheetStatus         String        @default("PENDING") @map("contact_sheet_status") // PENDING | READY | FAILED
  contactSheetError          String?       @map("contact_sheet_error") @db.Text
  technicalEvidence          Json?         @map("technical_evidence")
  disposition                String        @default("PENDING") // PENDING | WHOLE_CLIP | USABLE_RANGE | VISUAL_ONLY | SUBJECT_ONLY | REJECTED
  usableStartMs              Int?          @map("usable_start_ms")
  usableEndMs                Int?          @map("usable_end_ms")
  reviewNote                 String?       @map("review_note") @db.Text
  reviewedById               String?       @map("reviewed_by_id")
  reviewedAt                 DateTime?     @map("reviewed_at")
  continuityReferenceStatus  String        @default("PENDING") @map("continuity_reference_status") // PENDING | ELIGIBLE | INELIGIBLE
  continuityAnchorStorageKey String?       @map("continuity_anchor_storage_key")
  continuityAnchorTimeMs     Int?          @map("continuity_anchor_time_ms")
  continuityReferenceNote    String?       @map("continuity_reference_note") @db.Text
  continuityReviewedById     String?       @map("continuity_reviewed_by_id")
  continuityReviewedAt       DateTime?     @map("continuity_reviewed_at")
  createdAt                  DateTime      @default(now()) @map("created_at")
  updatedAt                  DateTime      @updatedAt @map("updated_at")

  @@index([projectId, disposition, updatedAt])
  @@map("video_evidence_packages")
}

// 与九步生成工作流分离的制作/交付状态，避免“素材生成完成”被误报为最终成片完成。
model ProductionDeliveryState {
  id           String                        @id @default(cuid())
  projectId    String                        @unique @map("project_id")
  project      Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  currentStage String                        @map("current_stage")
  updatedById  String?                       @map("updated_by_id")
  createdAt    DateTime                      @default(now()) @map("created_at")
  updatedAt    DateTime                      @updatedAt @map("updated_at")
  milestones   ProductionDeliveryMilestone[]

  @@map("production_delivery_states")
}

model ProductionDeliveryMilestone {
  id          String                  @id @default(cuid())
  stateId     String                  @map("state_id")
  state       ProductionDeliveryState @relation(fields: [stateId], references: [id], onDelete: Cascade)
  projectId   String                  @map("project_id")
  project     Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage       String
  evidence    Json
  note        String?                 @db.Text
  createdById String?                 @map("created_by_id")
  createdAt   DateTime                @default(now()) @map("created_at")

  @@unique([stateId, stage])
  @@index([projectId, createdAt])
  @@map("production_delivery_milestones")
}

// 成片时间线上的生成单元。一个完整生成视频对应一行；内部镜头不自动拆片。
model TimelineSegment {
  id               String               @id @default(cuid())
  projectId        String               @map("project_id")
  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  planId           String?              @map("plan_id")
  plan             VideoProductionPlan? @relation(fields: [planId], references: [id], onDelete: Cascade)
  stepName         String               @map("step_name")
  generationUnitId String               @map("generation_unit_id")
  generationUnit   GenerationUnit       @relation(fields: [generationUnitId], references: [id], onDelete: Cascade)
  generatedClipId  String?              @map("generated_clip_id")
  generatedClip    GeneratedClip?       @relation(fields: [generatedClipId], references: [id], onDelete: SetNull)
  sequence         Int
  sourceStartMs    Int                  @default(0) @map("source_start_ms")
  sourceEndMs      Int                  @map("source_end_ms")
  timelineStartMs  Int                  @map("timeline_start_ms")
  timelineEndMs    Int                  @map("timeline_end_ms")
  durationMs       Int                  @map("duration_ms")
  transition       Json?
  metadata         Json?
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  @@unique([planId, sequence])
  @@index([projectId, stepName, sequence])
  @@index([generatedClipId])
  @@index([generationUnitId])
  @@index([projectId, stepName, timelineStartMs])
  @@map("timeline_segments")
}

// 对原始生成素材的技术、语义和人工质量评估。一次素材可以有多次评估。
model VideoQualityAssessment {
  id              String        @id @default(cuid())
  projectId       String        @map("project_id")
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generatedClipId String        @map("generated_clip_id")
  generatedClip   GeneratedClip @relation(fields: [generatedClipId], references: [id], onDelete: Cascade)
  source          String        @default("STATIC") // STATIC | AI | HUMAN
  decision        String // HUMAN_REVIEW | DELIVERY_FAILED（旧记录可能保留 ACCEPT/RETRY/FALLBACK）
  overallScore    Float         @map("overall_score")
  confidence      Float
  scores          Json
  signals         Json?
  reasons         Json
  createdById     String?       @map("created_by_id")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([generatedClipId, createdAt])
  @@index([projectId, decision, createdAt])
  @@map("video_quality_assessments")
}

model CreativeIteration {
  id                  String   @id @default(cuid())
  projectId           String   @map("project_id")
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId              String   @map("user_id")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  versionNumber       Int      @map("version_number")
  originalInput       String   @map("original_input") @db.Text
  creativeContent     String   @map("creative_content") @db.Text
  retentionScore      Int?     @map("retention_score") // 原内容保留度 0-100
  qualityScore        Int?     @map("quality_score") // 优秀程度 0-100
  concerns            String?  @db.Text // AI 指出的核心顾虑
  improvementOptions  Json?    @map("improvement_options") // 改进选项数组
  selectedImprovement String?  @map("selected_improvement") // 用户选中的选项
  customFeedback      String?  @map("custom_feedback") @db.Text
  isCurrent           Boolean  @default(false) @map("is_current")
  createdAt           DateTime @default(now()) @map("created_at")

  // 注意：isCurrent 的唯一性由应用层保证（updateMany + create 的原子操作）
  @@index([projectId, versionNumber])
  @@map("creative_iterations")
}

model VoiceoverSegment {
  id           String   @id @default(cuid())
  projectId    String   @map("project_id")
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shotId       String   @map("shot_id") // 对应分镜 shotId
  stepName     String   @map("step_name") // 'VIDEO_DIRECT' | 'TRAILER'
  text         String   @db.Text // 配音文案/旁白
  speaker      String? // 说话人/角色名（如"旁白"）
  voiceId      String?  @map("voice_id") // MiniMax 音色 ID（AI 按角色人设自动分配）
  audioUrl     String?  @map("audio_url") // 生成后的音频 URL（R2 签名 URL）
  storageKey   String?  @map("storage_key") // R2 存储 key
  status       String   @default("pending") @map("status") // pending | generating | completed | failed
  sequence     Int      @map("sequence") // 配音顺序
  duration     Int?     @map("duration") // 音频时长（毫秒）
  errorMessage String?  @map("error_message") // 失败原因
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([projectId, status])
  @@index([projectId, stepName])
  @@index([projectId, sequence])
  @@index([projectId, shotId])
  @@map("voiceover_segments")
}
