# Public application URLs
NEXT_PUBLIC_APP_URL="https://your-domain.example"
NEXTAUTH_URL="https://your-domain.example"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabase Postgres
# Runtime on Vercel: Supavisor transaction pooler (port 6543)
DATABASE_URL="postgresql://postgres.your-project:password@your-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Prisma migrations: Supavisor session pooler or direct connection (port 5432)
DIRECT_URL="postgresql://postgres.your-project:password@your-region.pooler.supabase.com:5432/postgres"

# Cloudflare R2 (the only production media storage when configured)
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
R2_BUCKET_NAME="ai-film-assets"
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"

# OpenLux aggregator
OPENLUX_API_KEY="your-openlux-api-key"
OPENLUX_BASE_URL="https://api.openlux.ai"

# Other providers still used directly by selected features
DASHSCOPE_API_KEY="your-dashscope-api-key"
MINIMAX_API_KEY="your-minimax-api-key"

# Application secret
AUTH_SECRET="generate-a-strong-random-value"

# Vercel/Linux runtime
TEMP_DIR="/tmp"
FFMPEG_PATH="/var/task/ffmpeg"
