{
  "buildCommand": "if [ \"$VERCEL_ENV\" = \"production\" ]; then if [ -z \"$DIRECT_URL\" ]; then echo 'Error: DIRECT_URL is not set. Please set it to your Supabase direct connection URL (port 5432).'; exit 1; fi; echo 'Running prisma migrate deploy...' && timeout 180 npx prisma migrate deploy; fi && next build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "framework": "nextjs",
  "functions": {
    "app/api/projects/[id]/steps/framework/route.ts": {
      "maxDuration": 300
    },
    "app/api/projects/[id]/steps/character/route.ts": {
      "maxDuration": 300
    },
    "app/api/projects/[id]/steps/style/route.ts": {
      "maxDuration": 300
    },
    "app/api/projects/[id]/steps/concept/route.ts": {
      "maxDuration": 300
    },
    "app/api/projects/[id]/steps/storyboard/route.ts": {
      "maxDuration": 300
    },
    "app/api/projects/[id]/steps/keyframes/route.ts": {
      "maxDuration": 300
    },
    "app/api/projects/[id]/steps/trailer/route.ts": {
      "maxDuration": 300
    },
    "app/api/projects/[id]/steps/video-direct/route.ts": {
      "maxDuration": 300
    }
  }
}
