# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[your-anon-key]"

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# Mock Mode 总开关
MOCK_MODE=true

# Auth.js v5 (NextAuth.js) —— 前缀改为 AUTH_（v4 使用 NEXTAUTH_）
AUTH_SECRET="your-random-secret-min-32-chars-use-openssl-rand-base64-32"
AUTH_GITHUB_ID="your-github-oauth-app-id"
AUTH_GITHUB_SECRET="your-github-oauth-app-secret"
# NEXTAUTH_URL 保留仅用于某些回调场景
NEXTAUTH_URL="http://localhost:3000"

# Upstash Redis
UPSTASH_REDIS_URL="rediss://default:[token]@[host]:6379"

# Cloudflare R2（推荐，免费额度更大）
# 获取方式：Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="ai-film-assets"
R2_ENDPOINT="https://[account-id].r2.cloudflarestorage.com"

# Supabase Storage S3（如果 R2 已配置则此选项被忽略）
# 如需使用，请确保 R2_* 环境变量为空或注释掉
SUPABASE_STORAGE_S3_ENDPOINT=""
SUPABASE_STORAGE_S3_ACCESS_KEY_ID=""
SUPABASE_STORAGE_S3_SECRET_ACCESS_KEY=""
SUPABASE_STORAGE_BUCKET=""

# 聚合 AI API（yunwu.ai 平台）
XIAOMI_API_KEY="sk-bxOgUgYJaRSNsaIp93w4NCSR4QgL5Ys80eag3zDMXiwEv4X1"
XIAOMI_BASE_URL="https://yunwu.ai"

# 千问百聆 / DashScope（阿里云音乐生成）
DASHSCOPE_API_KEY="sk-..."

# MiniMax 官方 API（音乐生成 + 文字生成最高优先级）
# 文字生成：所有 IDEATION/FRAMEWORK/STORYBOARD/CHARACTER 等步骤
# 默认使用 MiniMax M2.7（模型名 MiniMax-Text-01），失败时回退到云雾供应商
MINIMAX_API_KEY="sk-..."

# 其他 AI API（Phase 6 再填）
KIMI_API_KEY=""
DEEPSEEK_API_KEY=""
ZHIPU_API_KEY=""
SILICONFLOW_API_KEY=""
KLING_API_KEY=""
RUNWAY_API_KEY=""
PIKA_API_KEY=""
ALIBABA_GREEN_ACCESS_KEY=""
ALIBABA_GREEN_SECRET=""

# 应用配置
NEXT_PUBLIC_APP_URL="http://localhost:3000"
TEMP_DIR=".temp"
FFMPEG_PATH="ffmpeg"
